#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Asset" (
        variants = { string shape = "Cube" }
        prepend variantSets = "shape"
    )
    {
        variantSet "shape" = {
            "Cube" {
                def Cube "Geometry" {
                    double size = 2
                    color3f[] primvars:displayColor = [(0.1, 0.4, 0.8)]
                }
            }
            "Sphere" {
                def Sphere "Geometry" {
                    double radius = 1.3
                    color3f[] primvars:displayColor = [(0.9, 0.25, 0.08)]
                }
            }
        }
    }
    def Scope "Lights"
    {
        def DistantLight "Key" {
            float inputs:intensity = 1000
            color3f inputs:color = (1, 0.9, 0.8)
        }
    }
}
